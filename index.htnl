<!doctype html>
<html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>ORIGINALITY</title>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif&family=Inter:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<style>
:root{--cream:#FFFEF7;--line:#EDEBE6;--muted:#8A8885;--soft:#F5F3EF}
*{box-sizing:border-box}body{margin:0;background:var(--cream);font-family:Inter,sans-serif;color:#111}
.serif{font-family:'Instrument Serif',serif}
header{position:sticky;top:0;z-index:20;background:rgba(255,254,247,.8);backdrop-filter:blur(20px);border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;padding:18px 28px}
.badge{background:#111;color:#fff;border-radius:999px;padding:4px 10px;font-size:12px}
.hero{max-width:680px;margin:80px auto 40px;text-align:center;padding:0 20px}
.small-caps{font-size:11px;letter-spacing:.25em;color:var(--muted);text-transform:uppercase}
.est{display:flex;align-items:center;gap:16px;justify-content:center;margin-top:32px;color:var(--muted);font-size:11px;letter-spacing:.2em}.est i{width:80px;height:1px;background:var(--line);display:block}
.controls{max-width:1100px;margin:48px auto 0;padding:0 24px;display:flex;flex-wrap:wrap;gap:12px}
.search{flex:1;min-width:280px;max-width:420px;position:relative}.search input{width:100%;background:#fff;border:1px solid var(--line);border-radius:999px;padding:14px 18px 14px 42px}.search span{position:absolute;left:16px;top:15px;opacity:.4}
.pill{border:1px solid var(--line);background:#fff;border-radius:999px;padding:10px 18px;font-size:13px;cursor:pointer}.pill.black{background:#111;color:#fff;border-color:#111}
.filters{display:flex;gap:10px;flex-wrap:wrap;margin:18px 24px 0;max-width:1100px;padding:0 24px}.filters button{border:0;background:var(--soft);border-radius:999px;padding:8px 14px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}.filters button.active{background:#111;color:#fff}
.grid{max-width:1200px;margin:28px auto;padding:0 24px;display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:22px}
.card{background:#fff;border:1px solid var(--line);border-radius:20px;overflow:hidden;box-shadow:0 8px 30px rgba(0,0,0,.04);transition:.3s}.card:hover{transform:translateY(-4px)}.cover{height:210px;background:var(--soft);position:relative;overflow:hidden}.cover img{width:100%;height:100%;object-fit:cover}.placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;text-align:center;padding:16px;font-family:'Instrument Serif';background:linear-gradient(135deg,#E8E0FF,#FFE9D6)}.bdg{position:absolute;left:10px;top:10px;font-size:9px;background:#111;color:#fff;border-radius:999px;padding:4px 8px}.meta{padding:12px 14px}.t{font-size:13px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.s{font-size:11px;color:var(--muted)}
.drawer{position:fixed;inset:0;z-index:40;display:none}.drawer.open{display:block}.overlay{position:absolute;inset:0;background:rgba(0,0,0,.18);backdrop-filter:blur(4px)}.panel{position:absolute;right:0;top:0;bottom:0;width:360px;max-width:90vw;background:#fff;padding:28px;overflow:auto}.profile{display:flex;gap:16px;align-items:center;margin-top:28px}.avatar{width:72px;height:72px;border-radius:999px;background:var(--soft);display:flex;align-items:center;justify-content:center;font-family:'Instrument Serif';font-size:28px;border:1px solid var(--line)}.sec{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;border-radius:999px;background:var(--soft);margin-bottom:10px;cursor:pointer}.sec.active{background:#111;color:#fff}.count{font-size:11px;background:#fff;border-radius:999px;padding:4px 8px}.modal{position:fixed;inset:0;z-index:60;background:rgba(0,0,0,.2);backdrop-filter:blur(8px);display:none;align-items:center;justify-content:center;padding:16px}.modal.open{display:flex}.box{background:#fff;border-radius:24px;padding:28px;width:100%;max-width:480px;border:1px solid var(--line)}.input{width:100%;border:0;border-bottom:1px solid #111;padding:10px 0;outline:none;font-size:14px;background:transparent;margin-top:14px}.lock{position:absolute;top:28px;right:48px;width:34px;height:34px;border-radius:999px;background:var(--soft);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;cursor:pointer}.lock.on{background:#111;color:#fff}
</style></head><body>
<header><div style="display:flex;gap:12px;align-items:center"><button id="menuBtn" style="font-size:24px;background:0;border:0">☰</button><span id="countBadge" class="badge">0</span></div><div style="text-align:center"><div class="small-caps" style="font-size:9px">Happens ending</div><div class="serif" style="font-size:32px;font-weight:600;line-height:.9">ORIGINALITY</div><div class="small-caps" style="font-weight:700;margin-top:4px">MALY DESIGN</div></div><div style="width:60px"></div></header>
<div class="hero"><div class="small-caps">A living index of imagined places</div><div class="serif" style="font-size:18px;color:#7a7875;margin-top:18px;line-height:1.6">a little shelf for people who fall in love with fictional worlds.<br>just one more chapter is never just one more chapter.</div><div class="est"><i></i>EST. 2024<i></i></div></div>
<div class="controls"><div class="search"><span>⌕</span><input id="q" placeholder="What do you want to read / watch?"/></div><button class="pill black" id="pdfBtn">↗ Upload PDF</button><button class="pill" id="imgBtn">🖼 Upload Image</button><button class="pill" id="coverBtn">+ Add Cover Only</button></div>
<div class="filters" id="filters"></div>
<div style="max-width:1200px;margin:36px auto 0;padding:0 24px;border-bottom:1px solid var(--line);padding-bottom:16px"><div class="small-caps">Everything saved</div><div class="serif" style="font-size:36px"><span id="total">0</span> stories</div></div>
<div class="grid" id="grid"></div>

  <input type="file" id="pdfFile" accept=".pdf" multiple hidden/><input type="file" id="imgFile" accept="image/*" multiple hidden/>
<div class="drawer" id="drawer"><div class="overlay" id="overlay"></div><div class="panel"><button id="closeDrawer" style="position:absolute;right:18px;top:18px;background:0;border:0;font-size:20px">✕</button><div class="small-caps">Your orbit</div><div class="serif" style="font-size:42px;line-height:.9;margin-top:8px">The curator</div><div class="lock" id="lockBtn">🔒</div><div class="profile"><div class="avatar">R</div><div><div style="font-weight:500">Rhett Butler</div><div style="font-size:12px;color:#8A8885">curator & collector</div></div></div><div style="margin-top:28px;display:flex;justify-content:space-between" class="small-caps"><span>Sections</span><span id="pieces">0 PIECES</span></div><div id="secList" style="margin-top:14px"></div><div id="makeRoom" style="margin-top:28px"><div class="small-caps" style="margin-bottom:10px">Make room</div><div style="display:flex;gap:8px"><input id="newSec" placeholder="New section" style="flex:1;border:1px solid var(--line);border-radius:999px;padding:12px 16px"/><select id="newType" style="border:1px solid var(--line);border-radius:999px;padding:12px"><option>Book</option><option>Movie</option><option>Series</option><option>Manga</option><option>Manhwa</option><option>Drama</option></select><button id="addSec" style="width:42px;border-radius:12px;background:#111;color:#fff;border:0">+</button></div></div><div id="viewOnly" style="display:none;margin-top:16px;background:var(--soft);border-radius:12px;padding:10px;text-align:center;font-size:11px">🔒 VIEW ONLY</div></div></div>
<div class="modal" id="addModal"><div class="box"><h2 class="serif" style="font-size:26px;margin:0">Add Cover Only</h2><input id="fTitle" class="input" placeholder="Title *"/><div style="display:flex;gap:8px;margin-top:12px"><select id="fSection" style="flex:1;border:1px solid var(--line);border-radius:999px;padding:10px"></select><select id="fType" style="border:1px solid var(--line);border-radius:999px;padding:10px"><option>Book</option><option>Movie</option><option>Series</option><option>Manga</option><option>Manhwa</option><option>Drama</option></select></div><div id="drop" style="margin-top:16px;border:1px dashed var(--line);border-radius:16px;height:160px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;background:var(--soft)"><span id="dropTxt" style="font-size:12px;color:var(--muted)">Drop cover image</span><img id="preview" style="display:none;height:100%;object-fit:contain"/><input type="file" id="coverFile" accept="image/*" style="position:absolute;inset:0;opacity:0;cursor:pointer"/></div><textarea id="fDesc" placeholder="Description" style="margin-top:14px;width:100%;border:1px solid var(--line);border-radius:12px;padding:12px;min-height:80px"></textarea><div style="display:flex;gap:8px;margin-top:10px"><input id="fLink" placeholder="Link" style="flex:1;border:1px solid var(--line);border-radius:999px;padding:10px;font-size:12px"/><input id="fYear" placeholder="Year" style="width:80px;border:1px solid var(--line);border-radius:999px;padding:10px;font-size:12px"/></div><div style="display:flex;gap:8px;margin-top:16px"><button id="fetchBtn" style="background:var(--soft);border:0;border-radius:999px;padding:10px 14px;font-size:12px">Fetch from Google</button><div style="flex:1"></div><button id="cancelAdd">Cancel</button><button id="saveAdd" style="background:#111;color:#fff;border-radius:999px;border:0;padding:10px 20px">Save</button></div></div></div>
<div class="modal" id="ownerModal"><div class="box" style="max-width:360px;text-align:center"><div class="serif" style="font-size:28px">Owner Access</div><input id="ownerPass" type="password" class="input" placeholder="Enter owner password"/><div style="margin-top:18px;display:flex;gap:8px;justify-content:center"><button id="ownerCancel" style="border:0;background:0">Cancel</button><button id="ownerUnlock" style="background:#111;color:#fff;border-radius:999px;padding:10px 20px;border:0">Unlock</button></div><div id="ownerErr" style="color:#c00;font-size:12px;margin-top:10px;display:none">Wrong password - alaiwa</div></div></div>


  <script>
pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
const DB='personal-book-nest-v7',STORE='books',S_STORE='sections';
let books=[],sections=[{id:'1',name:'Books',type:'Book'},{id:'2',name:'Drama',type:'Series'},{id:'3',name:'Films',type:'Movie'},{id:'4',name:'Manga',type:'Book'},{id:'5',name:'Manhwa',type:'Book'},{id:'6',name:'Series',type:'Series'},{id:'7',name:'Webtoons',type:'Book'}];
let active='All',search='',isOwner=localStorage.getItem('ownerUnlocked')==='true';
function openDB(){return new Promise((res,rej)=>{const r=indexedDB.open(DB,2);r.onupgradeneeded=e=>{const db=e.target.result;if(!db.objectStoreNames.contains(STORE))db.createObjectStore(STORE,{keyPath:'id'});if(!db.objectStoreNames.contains(S_STORE))db.createObjectStore(S_STORE,{keyPath:'id'})};r.onsuccess=()=>res(r.result);r.onerror=()=>rej(r.error)})}
async function dbPut(s,v){const db=await openDB();return new Promise((res,rej)=>{const tx=db.transaction(s,'readwrite');tx.objectStore(s).put(v);tx.oncomplete=()=>res();tx.onerror=()=>rej(tx.error)})}
async function dbGetAll(s){const db=await openDB();return new Promise((res,rej)=>{const tx=db.transaction(s,'readonly');const q=tx.objectStore(s).getAll();q.onsuccess=()=>res(q.result);q.onerror=()=>rej(q.error)})}
async function load(){const b=await dbGetAll(STORE);books=b;const s=await dbGetAll(S_STORE);if(s.length)sections=s;else sections.forEach(v=>dbPut(S_STORE,v));render()}
async function genCover(file,id){try{const data=await file.arrayBuffer();const pdf=await pdfjsLib.getDocument({data}).promise;const page=await pdf.getPage(1);const vp=page.getViewport({scale:1.8});const c=document.createElement('canvas');c.width=vp.width;c.height=vp.height;await page.render({canvasContext:c.getContext('2d'),viewport:vp}).promise;const cover=c.toDataURL('image/jpeg',0.75);const cur=books.find(x=>x.id===id);if(cur){cur.cover=cover;await dbPut(STORE,cur);render()}}catch(e){}}
function render(){
 document.getElementById('countBadge').textContent=books.length;document.getElementById('total').textContent=books.length;document.getElementById('pieces').textContent=books.length+' PIECES';
 const fEl=document.getElementById('filters');fEl.innerHTML='';['ALL','FICTION','NONFICTION','MYSTERY','ROMANCE','FANTASY','MOVIE','SERIES'].forEach(g=>{const b=document.createElement('button');b.textContent=g;if((active==='All'&&g==='ALL')||active===g)b.className='active';b.onclick=()=>{active=g==='ALL'?'All':g;render()};fEl.appendChild(b)});
 const secList=document.getElementById('secList');secList.innerHTML='';[{name:'All pieces',count:books.length}].concat(sections.map(s=>({name:s.name,type:s.type,count:books.filter(b=>b.section===s.name).length}))).forEach(it=>{const d=document.createElement('div');d.className='sec'+(active===it.name||(it.name==='All pieces'&&active==='All')?' active':'');d.innerHTML=`<div><div style="font-weight:500">${it.name}</div><div style="font-size:10px;opacity:.6">${(it.type||'').toUpperCase()}</div></div><span class="count">${it.count}</span>`;d.onclick=()=>{active=it.name==='All pieces'?'All':it.name;document.getElementById('drawer').classList.remove('open');render()};secList.appendChild(d)});
 document.getElementById('lockBtn').textContent=isOwner?'🔓':'🔒';document.getElementById('lockBtn').className='lock'+(isOwner?' on':'');document.getElementById('makeRoom').style.display=isOwner?'block':'none';document.getElementById('viewOnly').style.display=isOwner?'none':'block';
 let filtered=books.filter(b=>{const mSec=active==='All'||active==='ALL'||b.section===active||b.type===active;const mSearch=b.title.toLowerCase().includes(search.toLowerCase());return mSec&&mSearch});const grid=document.getElementById('grid');grid.innerHTML='';if(!filtered.length){grid.innerHTML=`<div style="grid-column:1/-1;text-align:center;padding:80px 0;opacity:.3"><div style="font-size:48px">📚</div><div style="margin-top:12px">Your shelf is quiet...</div></div>`;return}filtered.forEach(b=>{const card=document.createElement('div');card.className='card';card.innerHTML=`<div class="cover">${b.cover?`<img src="${b.cover}"/>`:`<div class="placeholder">${b.title}</div>`}<span class="bdg">${b.file?'PDF':'COVER'}</span></div><div class="meta"><div class="t">${b.title}</div><div class="s">${b.type||''} ${b.year?'· '+b.year:''}</div></div>`;card.onclick=()=>{if(!isOwner)return;if(confirm('Delete '+b.title+'?')){(async()=>{const db=await openDB();db.transaction(STORE,'readwrite').objectStore(STORE).delete(b.id);books=books.filter(x=>x.id!==b.id);render()})()}};grid.appendChild(card)});document.getElementById('fSection').innerHTML=sections.map(s=>`<option>${s.name}</option>`).join('');}
document.getElementById('menuBtn').onclick=()=>document.getElementById('drawer').classList.add('open');document.getElementById('overlay').onclick=()=>document.getElementById('drawer').classList.remove('open');document.getElementById('closeDrawer').onclick=()=>document.getElementById('drawer').classList.remove('open');document.getElementById('q').oninput=e=>{search=e.target.value;render()};
document.getElementById('pdfBtn').onclick=()=>{if(!isOwner){alert('Owner only - unlock 🔒');return}document.getElementById('pdfFile').click()};document.getElementById('imgBtn').onclick=()=>{if(!isOwner){alert('Owner only');return}document.getElementById('imgFile').click()};document.getElementById('coverBtn').onclick=()=>{if(!isOwner){alert('Owner only');return}document.getElementById('addModal').classList.add('open')};document.getElementById('cancelAdd').onclick=()=>document.getElementById('addModal').classList.remove('open');
document.getElementById('pdfFile').onchange=async e=>{for(const file of [...e.target.files]){const id=Date.now()+Math.random().toString(36).slice(2);const nb={id,title:file.name.replace('.pdf',''),section:'Books',type:'Book',file:true,cover:null,year:''};books.push(nb);await dbPut(STORE,nb);render();genCover(file,id);}e.target.value='';};
document.getElementById('imgFile').onchange=e=>{[...e.target.files].forEach(file=>{const r=new FileReader();r.onload=async ev=>{const id=Date.now().toString();const nb={id,title:file.name,section:'Books',type:'Book',cover:ev.target.result,year:''};books.push(nb);await dbPut(STORE,nb);render()};r.readAsDataURL(file)});e.target.value='';};
document.getElementById('coverFile').onchange=e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=ev=>{document.getElementById('preview').src=ev.target.result;document.getElementById('preview').style.display='block';document.getElementById('dropTxt').style.display='none';window._coverData=ev.target.result};r.readAsDataURL(f)};
document.getElementById('saveAdd').onclick=async()=>{const title=document.getElementById('fTitle').value.trim();if(!title||!window._coverData)return alert('Title + Cover required');const nb={id:Date.now().toString(),title,section:document.getElementById('fSection').value,type:document.getElementById('fType').value,cover:window._coverData,description:document.getElementById('fDesc').value,link:document.getElementById('fLink').value,year:document.getElementById('fYear').value};books.push(nb);await dbPut(STORE,nb);document.getElementById('addModal').classList.remove('open');render();};
document.getElementById('fetchBtn').onclick=async()=>{const title=document.getElementById('fTitle').value.trim(),year=document.getElementById('fYear').value.trim(),type=document.getElementById('fType').value;if(!title)return alert('Enter title');const btn=document.getElementById('fetchBtn');btn.textContent='Fetching...';let done=false;const setD=o=>{if(o.description)document.getElementById('fDesc').value=o.description;if(o.cover){window._coverData=o.cover;document.getElementById('preview').src=o.cover;document.getElementById('preview').style.display='block';document.getElementById('dropTxt').style.display='none'}if(o.year)document.getElementById('fYear').value=o.year;done=true};try{const omdb=await fetch(`https://www.omdbapi.com/?t=${encodeURIComponent(title)}&y=${year}&apikey=thewdb&plot=full`).then(r=>r.json());if(omdb.Response!=='False')setD({description:omdb.Plot,cover:omdb.Poster!=='N/A'?omdb.Poster:null,year:omdb.Year?.split('–')[0]})}catch{}if(!done){try{const tv=await fetch(`https://api.tvmaze.com/singlesearch/shows?q=${encodeURIComponent(title)}`).then(r=>r.json());if(tv?.summary)setD({description:tv.summary.replace(/<[^>]*>/g,''),cover:tv.image?.original,year:tv.premiered?.slice(0,4)})}catch{}}if(!done||type==='Manga'||type==='Manhwa'){try{const j=await fetch(`https://api.jikan.moe/v4/manga?q=${encodeURIComponent(title)}&limit=1`).then(r=>r.json());const m=j.data?.[0];if(m)setD({description:m.synopsis,cover:m.images?.jpg?.large_image_url,year:m.published?.from?.slice(0,4)})}catch{}}if(!done){try{const g=await fetch(`https://www.googleapis.com/books/v1/volumes?q=${encodeURIComponent(title)}`).then(r=>r.json());const b=g.items?.[0]?.volumeInfo;if(b)setD({description:b.description,cover:b.imageLinks?.thumbnail?.replace('http:','https:'),year:b.publishedDate?.slice(0,4)})}catch{}}if(!done){try{const w=await fetch(`https://en.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(title)}`).then(r=>r.json());if(w?.extract)setD({description:w.extract,cover:w.thumbnail?.source})}catch{}}btn.textContent='Fetch from Google';if(!done)alert('Not found - try shorter title like Clueless');};
document.getElementById('lockBtn').onclick=()=>{if(isOwner){isOwner=false;localStorage.removeItem('ownerUnlocked');render();return}document.getElementById('ownerModal').classList.add('open')};document.getElementById('ownerCancel').onclick=()=>{document.getElementById('ownerModal').classList.remove('open');document.getElementById('ownerErr').style.display='none'};document.getElementById('ownerUnlock').onclick=()=>{const p=document.getElementById('ownerPass').value;if(p==='alaiwa'){isOwner=true;localStorage.setItem('ownerUnlocked','true');document.getElementById('ownerModal').classList.remove('open');document.getElementById('ownerPass').value='';render();}else{document.getElementById('ownerErr').style.display='block'}};document.getElementById('addSec').onclick=async()=>{if(!isOwner)return alert('Owner only');const n=document.getElementById('newSec').value.trim(),t=document.getElementById('newType').value;if(!n)return;const ns={id:Date.now().toString(),name:n,type:t};sections.push(ns);await dbPut(S_STORE,ns);document.getElementById('newSec').value='';render();};load();
</script></body></html>
